{
    "name": "theqdev/laravel-minify",
    "keywords": [
        "minify",
        "laravel",
        "css",
        "javascript"
    ],
    "description": "A package for minifying styles and javascript for Laravel",
    "license": "MIT",
    "authors": [
        {
            "name": "Qdev Tech",
            "email": "contact@qdev.tech"
        }
    ],
    "require": {
        "php": "^8.1",
        "tedivm/jshrink": "~1.0",
        "natxet/cssmin": "3.*",
        "illuminate/filesystem": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "phpspec/phpspec": "^7.4",
        "mikey179/vfsstream": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "Qdev\\LaravelMinify\\": "src/"
        }
    },
    "minimum-stability": "stable",
    "extra": {
        "laravel": {
            "providers": [
                "Qdev\\LaravelMinify\\MinifyServiceProvider"
            ],
            "aliases": {
                "Minify": "Qdev\\LaravelMinify\\Facades\\MinifyFacade"
            }
        }
    }
}
